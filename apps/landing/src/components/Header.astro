---
import NavigationMenu from "@/components/starwind/navigation-menu/NavigationMenu.astro";
import NavigationMenuList from "@/components/starwind/navigation-menu/NavigationMenuList.astro";
import NavigationMenuItem from "@/components/starwind/navigation-menu/NavigationMenuItem.astro";
import NavigationMenuLink from "@/components/starwind/navigation-menu/NavigationMenuLink.astro";
import ThemeToggle from "@/components/starwind/theme-toggle/ThemeToggle.astro";
import { ENV } from "@/env";
---

<header
  class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center space-x-2">
        <span class="text-xl font-bold tracking-tight">Havenly</span>
      </a>
      <NavigationMenu>
        <NavigationMenuList class="flex items-center gap-4">
          <NavigationMenuItem>
            <NavigationMenuLink href="/about">About</NavigationMenuLink>
          </NavigationMenuItem>
          <NavigationMenuItem>
            <NavigationMenuLink href="/contact">Contact</NavigationMenuLink>
          </NavigationMenuItem>
        </NavigationMenuList>
      </NavigationMenu>
    </div>
    <div class="flex items-center gap-4">
      <ThemeToggle class="hidden lg:block" />
      <a href="/login" class="text-sm font-medium hover:underline">Login</a>
      <a
        href={ENV.DASHBOARD_URL}
        class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Get Started
      </a>
    </div>
  </div>
</header>
