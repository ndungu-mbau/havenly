---
import Button from '@/components/starwind/button/Button.astro';
import Label from '@/components/starwind/label/Label.astro';
---

<footer class="border-t bg-muted/40">
	<div class="container mx-auto px-4 py-12">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-4">
			<div class="col-span-1 md:col-span-2">
				<span class="text-xl font-bold tracking-tight">Havenly</span>
				<p class="mt-4 max-w-xs text-muted-foreground">
					The most trusted platform for modern property management and seamless rental experiences.
				</p>
			</div>
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider">Company</h3>
				<ul class="mt-4 space-y-2 text-sm text-muted-foreground">
					<li><a href="/about" class="hover:text-foreground transition-colors">About Us</a></li>
					<li><a href="/contact" class="hover:text-foreground transition-colors">Contact</a></li>
				</ul>
			</div>
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider">Legal</h3>
				<ul class="mt-4 space-y-2 text-sm text-muted-foreground">
					<li><a href="/tos" class="hover:text-foreground transition-colors">Terms of Service</a></li>
					<li><a href="/privacy" class="hover:text-foreground transition-colors">Privacy Policy</a></li>
				</ul>
			</div>
		</div>
		<div class="mt-12 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row">
			<p class="text-sm text-muted-foreground">
				© {new Date().getFullYear()} Havenly Inc. All rights reserved.
			</p>
			<div class="flex gap-4">
				<a href="#" class="text-muted-foreground hover:text-foreground">Twitter</a>
				<a href="#" class="text-muted-foreground hover:text-foreground">LinkedIn</a>
				<a href="#" class="text-muted-foreground hover:text-foreground">GitHub</a>
			</div>
		</div>
	</div>
</footer>
